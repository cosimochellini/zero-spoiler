// The Cloudflare Worker that serves the site. `npm run build` writes the
// deployable config to dist/server/wrangler.json, and `wrangler deploy` reads
// that one. Workers Builds runs both on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-spoiler",
  // Start's default entry plus the Early Hints `Link` header (#932).
  "main": "src/server.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // One address only. The workers.dev subdomain and per-version preview URLs
  // would serve the same pages under a second origin.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "zerospoiler.app", "custom_domain": true }],
  // The synced bookmarks (#1560): one key per reader, `sync:<id>`, read only
  // through src/server/sync/kv.ts. No id: the first deploy creates the
  // namespace and later ones keep it. The privacy notice says what it holds
  // (src/i18n/dictionaries/privacy.ts, `privacy.sync`).
  "kv_namespaces": [{ "binding": "SYNC" }],
  // Workers Logs keeps invocation and console logs for 3 days on Workers Free.
  // The privacy notice says so; changing this means rewriting it
  // (src/i18n/dictionaries/privacy.ts, `privacy.logs`).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false },
  },
}
