{
  "name": "zero-spoiler",
  "version": "1.113.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosimochellini/zero-spoiler.git"
  },
  "type": "module",
  "scripts": {
    "archive:dump": "node scripts/archive-dump.mjs",
    "archive:table": "node scripts/archive-table.mjs",
    "art:sheet": "node scripts/art-sheet.mjs",
    "art:shots": "node scripts/art-shots.mjs",
    "build": "vite build",
    "check": "node scripts/dependencies-fresh.mjs && npm run typecheck && npm run lint && npm run format:check && npm run gate:docs && npm run test && npm run build && npm run gate:react-doctor && npm run gate:fallow && npm run gate:archive",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite dev",
    "docs:chronicle": "node scripts/chronicle-verification.mjs",
    "docs:counts": "node scripts/archive-counts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:archive": "node scripts/archive-gate.mjs",
    "gate:docs": "node scripts/archive-counts.mjs --check",
    "gate:fallow": "node scripts/fallow-gate.mjs",
    "gate:react-doctor": "node scripts/react-doctor-gate.mjs",
    "issues:unblock": "node scripts/issues-unblock.mjs",
    "labels:sync": "node scripts/labels-sync.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "og:images": "node scripts/og-images.mjs",
    "prepare": "lefthook install",
    "provenance:pin": "node scripts/provenance-pin.mjs",
    "start": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:chapters": "node scripts/verify-chapters.mjs",
    "verify:filler": "node scripts/verify-filler.mjs",
    "verify:fruits": "node scripts/verify-fruit-showings.mjs",
    "verify:names": "node scripts/verify-names.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "wiki:pairs": "node scripts/wiki.mjs"
  },
  "overrides": {
    "unplugin": "3.4.0"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sort-es": "1.7.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-de-morgan": "2.3.0",
    "eslint-plugin-depend": "1.5.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.1.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "79.0.0",
    "fallow": "3.38.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.1.0",
    "puppeteer-core": "25.16.0",
    "react-doctor": "0.9.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.2"
  },
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.22.2",
    "npm": ">=12.2.1"
  }
}
